    {
      "id": "t8",
      "title": "Periodic expedition T1",
      "description": "Every 5 minutes: start a tier-1 expedition if none is active.",
      "author": "lifestarse",
      "tags": [
        "bundled"
      ],
      "stars": 0,
      "program": {
        "name": "expedition T1",
        "trigger": "on_tick",
        "enabled": true,
        "tick_interval": 300,
        "ops_per_sec": 10000,
        "g_var_init": {},
        "body": [
          {
            "_kind": "If",
            "cond": {
              "_kind": "UnaryOp",
              "op": "not",
              "operand": {
                "_kind": "EngineField",
                "field_name": "expedition_active"
              }
            },
            "then_body": [
              {
                "_kind": "Action",
                "name": "start_expedition",
                "args": [
                  {
                    "_kind": "Const",
                    "value": 1
                  }
                ]
              }
            ],
            "else_body": []
          }
        ]
      }
    },
  "kind": "gladiator_script_v1",
  "program": {
    "name": "auto-farm to 500k",
    "trigger": "on_tick",
    "enabled": true,
    "tick_interval": 1,
    "ops_per_sec": 0,
    "g_var_init": {},
    "body": [
      {
        "_kind": "While",
        "cond": {
          "_kind": "BinOp",
          "op": "<",
          "lhs": {
            "_kind": "EngineField",
            "field_name": "gold"
          },
          "rhs": {
            "_kind": "Const",
            "value": 1000000
          }
        },
        "body": [
          {
            "_kind": "Action",
            "name": "start_arena_battle",
            "args": []
          }
        ]
      }
    ]
  }
