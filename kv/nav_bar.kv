#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:import theme game.theme
#:import ScrollEffect kivy.effects.scroll.ScrollEffect

<NavBar>:
    active_screen: app.sm.current if app.sm else ""
    size_hint_y: None
    height: dp(70)
    canvas.before:
        Color:
            rgba: app.nav_bg
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: app.divider
        Rectangle:
            pos: self.x, self.top - 1
            size: self.width, dp(1)
    NavButton:
        text: app.nav_pit
        icon_source: "sprites/nav/nav_arena.png"
        is_active: root.active_screen == "arena"
        on_press: app.sm.current = "arena"
    NavButton:
        text: app.nav_squad
        icon_source: "sprites/nav/nav_roster.png"
        is_active: root.active_screen == "roster"
        on_press: app.sm.current = "roster"
    NavButton:
        text: app.nav_anvil
        icon_source: "sprites/nav/nav_forge.png"
        is_active: root.active_screen == "forge"
        on_press: app.sm.current = "forge"
    NavButton:
        text: app.nav_hunts
        icon_source: "sprites/nav/nav_expedition.png"
        is_active: root.active_screen == "expedition"
        on_press: app.sm.current = "expedition"
    NavButton:
        text: app.nav_lore
        icon_source: "sprites/nav/nav_lore.png"
        is_active: root.active_screen == "lore"
        on_press: app.sm.current = "lore"
    NavButton:
        text: app.nav_more
        icon_source: "sprites/nav/nav_more.png"
        is_active: root.active_screen == "more"
        on_press: app.sm.current = "more"

<CurrencyChip@BoxLayout>:
    value_text: ""
    icon_src: ""
    value_color: app.accent_gold
    padding: [dp(7), dp(6)]
    spacing: dp(2)
    canvas.before:
        Color:
            rgba: app.bg_elevated
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: theme.BTN_OUTLINE
        Line:
            rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1)
            width: 1.1
    AutoShrinkLabel:
        text: root.value_text
        single_line: True
        font_size: "11sp"
        bold: True
        color: root.value_color
        halign: "right"
        text_size: self.size
        valign: "middle"
    Image:
        source: root.icon_src
        fit_mode: "contain"
        size_hint: None, 1
        width: dp(16)

<TopBar@BoxLayout>:
    title_text: ""
    title_color: app.accent_gold
    size_hint_y: None
    height: dp(56)
    padding: [dp(10), dp(10)]
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: app.nav_bg
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: app.divider
        Rectangle:
            pos: self.x, self.y
            size: self.width, dp(1)
    AutoShrinkLabel:
        text: self.parent.title_text if self.parent else ""
        single_line: True
        font_size: "13sp"
        bold: True
        color: self.parent.title_color if self.parent else [1,1,1,1]
        halign: "left"
        text_size: self.size
        valign: "middle"
        size_hint_x: 0.42
    CurrencyChip:
        size_hint_x: 0.29
        value_text: app.top_gold
        value_color: app.accent_gold
        icon_src: "sprites/icons/ic_gold.png"
    CurrencyChip:
        size_hint_x: 0.29
        value_text: app.top_diamonds
        value_color: app.accent_cyan
        icon_src: "sprites/icons/ic_gem.png"

# ============================================================
#  ARENA (THE PIT) — Battle System
# ============================================================
